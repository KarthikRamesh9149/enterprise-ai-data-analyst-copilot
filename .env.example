APP_ENV=local
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/copilot
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-this-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=25
DUCKDB_PATH=storage/duckdb/analytics.duckdb
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SQL_GENERATOR_PROVIDER=mock
REPORT_GENERATOR_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0
MAX_OUTPUT_TOKENS=1200
MLFLOW_TRACKING_URI=sqlite:///storage/mlflow/mlflow.db
RATE_LIMIT_PER_MINUTE=60
